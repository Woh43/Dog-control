; 保留的上游通用步态模板；当前自定义 NMPC/WBC 后端没有加载本文件。
; 实际 Trot 周期读取 controllers.yaml 的 trot_period_s（当前 0.40 s），
; 四足支撑重叠由已声明的 trot_double_support_s 控制（未写出时默认 0）。
; 修改下面 0.25 s 的模板不会改变当前运行周期；计划接触模式也不等于足底传感器反馈。

; 通用步态模板名称列表；这里只作兼容保留，不是本机状态机当前可执行的模式开关。
list
{
  [0] stance
  [1] trot
}

; 四足站立模板。
stance
{
  ; 按时间依次使用的计划支撑模式。
  modeSequence
  {
    ; 四足同时计划支撑；不是足底接触测量。
    [0] STANCE
  }
  ; 各相位边界时刻，单位 s；首值是起点，末值是此模板周期终点。
  switchingTimes
  {
    ; 模板起始时刻，单位 s。
    [0] 0.0
    ; 站立模板终点，长度 0.50 s；重复模板不会让机器人自动换腿。
    [1] 0.50
  }
}

; 对角 Trot 模板；本文件模板全周期为 0.25 s，与当前实际 0.40 s 不同。
trot
{
  ; 按时间依次使用的计划支撑模式。
  modeSequence
  {
    ; 左前 FL＋右后 RR 计划支撑，另两腿处于摆动相。
    [0] LF_RH
    ; 右前 FR＋左后 RL 计划支撑，另两腿处于摆动相。
    [1] RF_LH
  }
  ; 各相位边界时刻，单位 s；首值是起点，末值是此模板周期终点。
  switchingTimes
  {
    ; 模板起始时刻，单位 s。
    [0] 0.0
    ; 从第一组对角支撑切到第二组的模板时刻，单位 s。
    [1] 0.125
    ; 此 Trot 模板终点，第二相也为 0.125 s；当前后端不使用这个周期。
    [2] 0.25
  }
}
